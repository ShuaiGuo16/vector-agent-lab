# Copy to .env and fill credentials. Never commit .env or use VITE_ for secrets.
# The normal launcher/harness use config/working-candidate.json for model settings.
AZURE_ENDPOINT=
AZURE_API_KEY=
OPENROUTER_API_KEY=

# Azure endpoint is the shared resource root, without API paths or query parameters.
# Both Responses and Decision-1 share this resource/key. The current candidate
# uses OpenRouter Sol/Jev/Luna. Azure remains available for explicit experiments.
# AZURE_DECISION_DEPLOYMENT=Decision-1

# Optional connection metadata.
OPENROUTER_BASE_URL=https://openrouter.ai/api
OPENROUTER_SITE_URL=http://127.0.0.1:5176
OPENROUTER_APP_NAME=VECTOR Agent Lab

# Advanced experiments: scripts/run-parallel.py --no-preset reads model settings
# from env. Ordinary candidate runs ignore these optional overrides in .env;
# explicit harness arguments override the preset. See RUNTIME-LIMITS.txt.
# MODEL_PROVIDER=azure
# AZURE_LLM_DEPLOYMENT=gpt-6.1-sol
# DECISION_PROVIDER=openrouter
# DECISION_MODEL=typesafe/jev-1.14
# REVIEW_PROVIDER=openrouter
# REVIEW_MODEL=openai/gpt-6-luna
# REVIEW_SCHEDULE=planned
# DECISION_INTERVAL_MS=4000
# ACTION_MAX_AGE_MS=2250
